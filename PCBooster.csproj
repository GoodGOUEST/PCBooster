<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- ★ K5修复: 移除全局 PlatformTarget，避免 ARM64 错靶 -->
    <Platforms>x64;ARM64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>PCBooster</RootNamespace>
    <AssemblyTitle>PC Booster</AssemblyTitle>
    <Version>3.6.9</Version>
    <!-- ★ 3.6.8: 本机仅装 .NET 10 运行时；允许 net8.0 产物在更高主版本运行时上启动 -->
    <RollForward>LatestMajor</RollForward>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ★ UI 重写: DPI 由 SDK 注入清单，避免手写清单与 SetHighDpiMode 冲突 -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>